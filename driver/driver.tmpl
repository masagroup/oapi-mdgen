{{define "main"}}
# {{.Infos.Title}} ({{.Infos.Version}})
{{.Infos.Description}}
{{template "endpoints" .}}
{{template "schemas" .}}
{{end}}

{{define "endpoints"}}
{{range $tag, $endpoints := .TagToEndpoints}}
## {{$tag}}
{{range $endpoint := $endpoints}}
<a id="{{$endpoint.OperationId}}"></a>
<details>
<summary><code>{{$endpoint.Method}}</code> <code><b>{{$endpoint.Path}}</b></code> <code><i>{{$endpoint.Summary}}</i></code></summary>
{{if $endpoint.Description}}
{{$endpoint.Description}}
{{end}}
{{if or $endpoint.Parameters $endpoint.RequestBody}}
### Parameters
> | name | in | data type | required | description |
> | --- | --- | --- | --- | --- |
{{range $param := $endpoint.Parameters -}}
> | {{$param.Name}} | {{$param.In}} | {{template "schemaType" dict "SchemaProxy" $param.Schema}} | {{or $param.Required "false"}} | {{$param.Description}}  |
{{end -}}
{{- end -}}
{{if $endpoint.RequestBody -}}
{{- $bodyID := print $endpoint.OperationId "Body" -}}
> | body | body | {{template "bodyType" dict "Body" $endpoint.RequestBody}} | {{or $endpoint.RequestBody.Required "false"}} | {{$endpoint.RequestBody.Description}}  |
{{- $content := $endpoint.RequestBody.Content -}}
{{- if eq (and $content $content.Len) 1 -}}
{{template "bodySchema" dict "SchemaProxy" $content.First.Value.Schema "Depth" 0}}
{{end}}
{{end}}
{{if $endpoint.Responses}}
### Responses
> | status | description | schema |
> | --- | --- | --- |
{{range $status, $response := $endpoint.Responses.Codes.FromOldest -}}
{{- $responseID := print $endpoint.OperationId "Response" $status -}}
> | {{$status}} | {{$response.Description}} | {{template "contentType" dict "Description" $responseID  "Content" $response.Content}} |
{{end}}
{{end}}
</details>
{{end}}
{{end}}
{{end}}

{{define "schemas"}}
## Schemas
{{range $ref, $schema := .RefToSchema}}
<a id="{{refID $ref}}"></a>
<details>
<summary><code>{{refName $ref}}</code></summary>
{{if $schema.Properties}}
### Properties
> | name | type | required | description |
> | --- | --- | --- | ---  |
{{range $name, $prop := $schema.Properties.FromOldest -}}
> | {{$name}} | {{template "schemaType" dict "SchemaProxy" $prop}} | {{contains $schema.Required $name}} | {{$prop.Schema.Description}} |
{{end}}
{{else if $schema.Items -}}
### Properties
> | name | type | required | description |
> | --- | --- | --- | --- |
> | *anonymous* | [{{template "schemaType" dict "SchemaProxy" $schema.Items.A}}] | false | none  |
{{end}}
</details>
{{end}}
{{end}}

{{/* generate inline body schema */}}
{{define "bodySchema"}}
    {{- with $dict := . -}}
        {{- $depth := $dict.Depth -}}
        {{- $schemaProxy := $dict.SchemaProxy -}}
        {{- if not $schemaProxy.IsReference -}}
            {{- with $schema := $schemaProxy.Schema}}
            {{- range $name, $prop := $schema.Properties.FromOldest}}
> | {{range until $depth}}  {{end}}└── {{$name}} | body | {{template "schemaType" dict "SchemaProxy" $prop}} | {{contains $schema.Required $name}} | {{$prop.Schema.Description}} |
                {{- if not $prop.IsReference -}}                   
                    {{- with  $type := index $schema.Type 0 -}}
                        {{- if eq $type "object" -}}
{{template "bodySchema" dict "SchemaProxy" $prop "Depth" (add $depth 1)}}
                        {{- end -}}
                    {{- end -}}
                {{- end -}}
            {{- end -}}
            {{- end -}}
        {{- end -}}
    {{- end -}}
{{end}}

{{/* generate body type */}}
{{define "bodyType"}}
    {{- with $dict := . -}}
        {{- $body := .Body -}}
        {{- $description := .Description -}}
        {{template "contentType" dict "Description" $description "Content" $body.Content}}
    {{- end -}}
{{end}}

{{/* generate content type */}}
{{define "contentType"}}
    {{- with $dict := . -}}
        {{- $content := $dict.Content -}}
        {{- $description := $dict.Description -}}
        {{- $showContentType := and $content (gt $content.Len 1) -}}
        {{if $showContentType}}<dl>{{end}}
        {{- range $contentType, $mediaType := $content.FromOldest -}}
            {{- $contentDesc := and $description (refID (print $description "-" $contentType)) -}}
            {{- if $showContentType -}}<dt>**{{$contentType}}**</dt><dd>{{- end -}}{{template "schemaType" dict "Description" $contentDesc "SchemaProxy" $mediaType.Schema }}{{- if $showContentType -}}</dd>{{- end -}}
        {{- end -}}
        {{if $showContentType}}</dl>{{end}}
    {{- end -}}
{{end}}


{{/* generate schema proxy type */}}
{{define "schemaType"}}
    {{- with $dict := . -}}
        {{- $schemaProxy := $dict.SchemaProxy -}}
        {{- $description := $dict.Description -}}
        {{- if $schemaProxy.IsReference -}}
            [{{ refName $schemaProxy.GetReference }}](#{{ refAnchor $schemaProxy.GetReference}})
        {{- else -}}
            {{- with $schema := $schemaProxy.Schema -}}
                {{- if .Type -}}
                    {{- with $type := index .Type 0 -}}
                        {{- if eq $type "array" -}}
                            [{{template "schemaType" dict "Description" $description "SchemaProxy" $schema.Items.A}}]
                        {{- else if eq $type "object" -}}
                            {{- if $description -}}
                            [object](#{{refID (print $description "-" $schema.Title)}})
                            {{- else -}}
                            object
                            {{- end -}}
                        {{- else  -}}
                            {{- $type -}}{{if  $schema.Format -}}({{ $schema.Format }}){{- end -}}
                        {{- end -}}
                    {{- end -}}
                    {{- if .Enum -}}
                        <br/>*Available values:* {{range $index,$value := .Enum}}{{- if $index -}}, {{ end -}}{{- $value.Value -}}{{- end -}}
                    {{- end -}}
                    {{- if .Default -}}
                        <br/>*Default value:* {{.Default.Value}}
                    {{- end -}}
                {{- end -}}
            {{- end -}}
        {{- end -}}
    {{- end -}}
{{end}}

